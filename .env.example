# Google Service Account（Sheets 讀寫 + Calendar 寫入）
# 使用者的 Google Sheet 與 Calendar 都必須共用給這個 Service Account email
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# 管理用 Google Sheet
# users 分頁：A 欄 = 使用者名稱（僅英文字母）、B 欄 = PIN（4~6 位數字）
# settings 分頁：A 欄 = 使用者名稱、B 欄 = sheetId、C 欄 = calendarId
ADMIN_SHEET_ID=your-admin-sheet-id

# iCloud CalDAV（共用行事曆，由管理者統一設定）
ICLOUD_APPLE_ID=your-apple-id@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ICLOUD_CALENDAR_NAME=貓咪照護

# 登入 cookie 的 HMAC-SHA256 簽章金鑰（任意隨機字串，越長越好）
# 舊部署若已設 TOKEN_ENCRYPTION_KEY，會自動沿用該值
SESSION_SECRET=your-random-secret-key-here
